# ==============================================================================
# VitalSenior - Reglas Estrictas de Seguridad DevSecOps (.gitignore)
# Stack: PHP 8 MVC + PostgreSQL + Tailwind CSS + Twilio
# ==============================================================================

# 1. Variables de Entorno y Secretos Criptográficos (CRÍTICO: Anti-Fugas)
.env
.env.*
.env.backup
.env.production
.env.staging
.env.example
ENV_SECRETS_HANDOVER.md
*secrets*
*handover*


# 2. Gestor de Paquetes de Terceros y Entornos de Agente
/vendor/
/node_modules/
.agents/
composer.phar
/scratch/
venv/
.venv/
env/
ENV/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Bases de Datos Locales y Volcados Temporales
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.tar
*.sql.bak
dump.sql
/bd-vitalsenior.sql
/database_completa.sql


# 4. Registros del Sistema y Logs Privados (Excluyendo .gitkeep)
/logs/*
!/logs/.gitkeep
*.log

# 5. Almacenamiento Privado de Documentos y Expedientes Médicos (GD / Uploads)
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/uploads/expedientes/*
!/storage/uploads/expedientes/.gitkeep
/storage/temp/*
/storage/cache/*

# 6. Archivos de Configuración de IDEs y Editores de Código
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# 7. Metadatos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Archivos Temporales y Caché de PHP y Python
*.tmp
*.bak
*.old
.phpunit.result.cache
.php-cs-fixer.cache
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
/staticfiles/
/graphify-out/
docker-compose.override.yml