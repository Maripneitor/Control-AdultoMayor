generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAMILIAR
  ADULTO_MAYOR
}

enum MedLogStatus {
  PENDING
  TAKEN
  UNDONE
  MISSED
}

model User {
  id               String   @id @default(uuid())
  role             Role     @default(FAMILIAR)
  name             String
  phone            String   @unique
  whatsappVerified Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientsManaged PatientProfile[] @relation("FamilyManager")
  ownProfile      PatientProfile?  @relation("IndependentUser")
}

model PatientProfile {
  id          String   @id @default(uuid())
  publicId    String   @unique @default(uuid()) // UUIDv4 para Ficha Pública Segura
  name        String
  birthDate   DateTime?
  
  // Perfiles administrados por familiares
  managerId   String?
  manager     User?    @relation("FamilyManager", fields: [managerId], references: [id])

  // Promover a cuenta independiente (Vista 5)
  userId      String?  @unique
  user        User?    @relation("IndependentUser", fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medications Medication[]
  files       MedicalFile[]
}

model Medication {
  id           String   @id @default(uuid())
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  name         String
  instructions String?
  createdAt    DateTime @default(now())
  
  logs         MedicationLog[]
}

model MedicationLog {
  id             String       @id @default(uuid())
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id])
  status         MedLogStatus @default(PENDING)
  scheduledFor   DateTime     // Almacenado en UTC
  takenAt        DateTime?    // Almacenado en UTC
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MedicalFile {
  id          String   @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  fileName    String
  fileUrl     String   // URL del bucket, e.g. S3
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}
